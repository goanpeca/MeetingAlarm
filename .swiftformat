# SwiftFormat configuration — deterministic formatting for the whole repo.
--swiftversion 6.0
--indent 4
--maxwidth 100
--wraparguments before-first
--wrapparameters before-first
--wrapcollections before-first
--commas inline
--trimwhitespace always
--self remove
--stripunusedargs closure-only
# Keep the opening brace on the same line as a wrapped condition, so SwiftFormat and
# SwiftLint's `opening_brace` rule agree.
--disable wrapMultilineStatementBraces
--exclude .build,Resources,MeetingAlarm.app
