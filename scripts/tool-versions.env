# Pinned lint/format tool versions + release-zip checksums. Single source of truth for
# `scripts/install-tools.sh`, used by `make` (local) and CI alike, so the exact same binaries
# run everywhere — unpinned `brew install` let CI (0.63.1) and local (0.64.1) drift apart.
# To bump: change the version, run `curl -fsSL <url> | shasum -a 256`, update the checksum.
#   swiftformat: https://github.com/nicklockwood/SwiftFormat/releases/download/$V/swiftformat.zip
#   swiftlint:   https://github.com/realm/SwiftLint/releases/download/$V/portable_swiftlint.zip
SWIFTFORMAT_VERSION=0.64.1
SWIFTFORMAT_SHA256=0e5762a848d738602c7a983b26812031e634d85e357db070968b9c805f253eff
SWIFTLINT_VERSION=0.65.1
SWIFTLINT_SHA256=c1e429b0599cf1b516f369a2d9ec04eaf0e436f3c12b637df8851fa52ff694d0
